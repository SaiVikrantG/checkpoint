CHECKPOINT_PRIMARY.ENV="local"

CHECKPOINT_SERVER.PORT="8080"
CHECKPOINT_SERVER.READ_TIMEOUT="30"
CHECKPOINT_SERVER.WRITE_TIMEOUT="30"
CHECKPOINT_SERVER.IDLE_TIMEOUT="60"
CHECKPOINT_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

CHECKPOINT_DATABASE.HOST="127.0.01"
CHECKPOINT_DATABASE.PORT="5432"
CHECKPOINT_DATABASE.USER="postgres"
CHECKPOINT_DATABASE.PASSWORD=""
CHECKPOINT_DATABASE.NAME="checkpoint"
CHECKPOINT_DATABASE.SSL_MODE="disable"
CHECKPOINT_DATABASE.MAX_OPEN_CONNS="25"
CHECKPOINT_DATABASE.MAX_IDLE_CONNS="25"
CHECKPOINT_DATABASE.CONN_MAX_LIFETIME="300"
CHECKPOINT_DATABASE.CONN_MAX_IDLE_TIME="300"

CHECKPOINT_INTEGRATION.RESEND_API_KEY="resend_key"

CHECKPOINT_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
CHECKPOINT_OBSERVABILITY.SERVICE_NAME="checkpoint"
CHECKPOINT_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
CHECKPOINT_OBSERVABILITY.LOGGING.LEVEL="debug"
CHECKPOINT_OBSERVABILITY.LOGGING.FORMAT="console"
CHECKPOINT_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
CHECKPOINT_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xx"
CHECKPOINT_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
CHECKPOINT_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
CHECKPOINT_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
CHECKPOINT_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
CHECKPOINT_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
CHECKPOINT_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
CHECKPOINT_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database"