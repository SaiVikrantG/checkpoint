# Copy to deploy/.env on the VPS (gitignored, never committed).
#
# Two things read this file:
#   1. docker compose itself, for ${VAR} substitution in docker-compose.yml and Caddyfile
#      (DOMAIN, POSTGRES_*).
#   2. The backend container, via `env_file:` in docker-compose.yml (all CHECKPOINT_* vars).
#
# Note: CHECKPOINT_DATABASE.HOST/PORT/USER/PASSWORD/NAME and
# CHECKPOINT_SERVER.CORS_ALLOWED_ORIGINS are already set explicitly in docker-compose.yml's
# `environment:` block (derived from POSTGRES_*/DOMAIN below) and don't need to be repeated here
# — anything set there takes precedence over this file.

DOMAIN=checkpoint.example.com

POSTGRES_USER=checkpoint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=checkpoint

CHECKPOINT_SERVER.PORT=8080
CHECKPOINT_SERVER.READ_TIMEOUT=10
CHECKPOINT_SERVER.WRITE_TIMEOUT=10
CHECKPOINT_SERVER.IDLE_TIMEOUT=60

CHECKPOINT_DATABASE.SSL_MODE=disable
CHECKPOINT_DATABASE.MAX_OPEN_CONNS=10
CHECKPOINT_DATABASE.MAX_IDLE_CONNS=5
CHECKPOINT_DATABASE.CONN_MAX_LIFETIME=300
CHECKPOINT_DATABASE.CONN_MAX_IDLE_TIME=60

CHECKPOINT_AUTH.SECRET_KEY=change-me
CHECKPOINT_AUTH.WEBHOOK_SECRET=change-me
CHECKPOINT_AUTH.DEFAULT_ROLE=user

CHECKPOINT_OBSERVABILITY.NEW_RELIC.LICENSE_KEY=change-me

# --- Deploy tooling (Diun + webhook trigger + deploy-backend.sh) ---
# Underscore-separated (not dotted like the CHECKPOINT_* app config above) because
# deploy-backend.sh parses these directly out of this file with grep/cut rather than
# bash `source`-ing it whole — dotted keys aren't valid bash variable names and would
# abort the script under `set -e` the moment `source` hit one.
#
# read:packages-scoped PAT, used only by Diun to check tags on GHCR. Never used in CI.
CHECKPOINT_DEPLOY_GHCR_PAT=change-me
# Shared secret the webhook hook validates before running deploy-backend.sh.
CHECKPOINT_DEPLOY_WEBHOOK_SECRET=change-me
# ntfy.sh topic URL for deploy/rollback notifications. Use a long random topic name —
# ntfy.sh topics are public/unauthenticated, so anyone who guesses the name can publish
# or read from it. Keep the full URL only here, never commit it.
CHECKPOINT_DEPLOY_NTFY_TOPIC_URL=https://ntfy.sh/checkpoint-deploy-change-me
CHECKPOINT_DEPLOY_HEALTHCHECK_RETRIES=10
CHECKPOINT_DEPLOY_HEALTHCHECK_INTERVAL_SECONDS=3

# See deploy/current-tag.env.example — copy that to deploy/current-tag.env separately
# (gitignored, holds only BACKEND_TAG, mutated by deploy-backend.sh on every deploy).
